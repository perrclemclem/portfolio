msgid "COMPÉTENCE"
msgstr ""

#: .\myapp\template\myapp\competence1.html:10
msgid ""
"\n"
"    <h2>Compétence 1 — Réaliser un développement d’application</h2>\n"
"    <p>Développer — c'est-à-dire concevoir, coder, tester et intégrer — une "
"solution informatique \n"
"        pour un client, en respectant les besoins décrits, en appliquant les "
"principes algorithmiques, \n"
"        en veillant à la qualité du code et à sa documentation, et en "
"choisissant les ressources techniques appropriées.</p>\n"
"    "
msgstr ""

#: .\myapp\template\myapp\competence1.html:24
msgid ""
"\n"
"                <h5>AC1 – Implémenter des conceptions simples</h5>\n"
"                <p>Traduire une conception simple (diagrammes, schémas, "
"algorithmes) en code exécutable.</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence1.html:32
msgid ""
"\n"
"                <h5>AC2 – Élaborer des conceptions simples</h5>\n"
"                <p>Concevoir une solution à partir d’un problème donné, en "
"utilisant des modèles simples (par ex. diagrammes UML).</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence1.html:39
msgid ""
"\n"
"                <h5>AC3 – Faire des essais et évaluer leurs résultats en "
"regard des spécifications</h5>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence1.html:45
msgid ""
"\n"
"                <h5>AC4 – Développer des interfaces utilisateurs</h5>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence1.html:53
msgid ""
"\n"
"            <h4>B. Partir des exigences et aller jusqu’à une application "
"complète</h4>\n"
"            "
msgstr ""

#: .\myapp\template\myapp\competence1.html:58
msgid ""
"\n"
"                <h5>AC1 – Élaborer et implémenter les spécifications "
"fonctionnelles et non fonctionnelles à partir des exigences</h5>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence1.html:111
msgid ""
"\n"
"                <h5>AC2 – Appliquer des principes d’accessibilité et "
"d’ergonomie</h5>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence1.html:118
msgid ""
"\n"
"                <h5>AC3 – Adopter de bonnes pratiques de conception et de "
"programmation</h5>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence1.html:124
msgid ""
"\n"
"                <h5>AC4 – Vérifier et valider la qualité de l’application "
"par les tests</h5>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence2.html:10
msgid ""
"\n"
"    <h2>Compétence 2 — Optimiser des applications</h2>\n"
"    <p>Proposer des applications informatiques optimisées en fonction de "
"critères spécifiques : \n"
"        temps d'exécution, précision, consommation de ressources… en "
"formalisant et modélisant des \n"
"        situations complexes, en recensant les algorithmes et les structures "
"de données usuels, \n"
"        en s'appuyant sur des schémas de raisonnement, et en justifiant les "
"choix et validant les résultats.</p>\n"
"    "
msgstr ""

#: .\myapp\template\myapp\competence2.html:22
msgid ""
"\n"
"            <h4>A. Appréhender et construire des algorithmes</h4>\n"
"            "
msgstr ""

#: .\myapp\template\myapp\competence2.html:27
msgid ""
"\n"
"                <h5>AC1 – Analyser un problème avec méthode</h5>\n"
"                <p>Découper un problème en éléments algorithmiques simples "
"et identifier les structures de données adaptées.</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence2.html:34
msgid ""
"\n"
"                <h5>AC2 – Comparer des algorithmes pour des problèmes "
"classiques</h5>\n"
"                <p>Évaluer et comparer différents algorithmes (par exemple "
"pour le tri ou la recherche) selon leurs performances et leur complexité.</"
"p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence2.html:41
msgid ""
"\n"
"                <h5>AC3 – Formaliser et mettre en œuvre des outils "
"mathématiques pour l’informatique</h5>\n"
"                <p>Utiliser les outils mathématiques (logique, combinatoire, "
"probabilités, graphes, etc.) pour modéliser et résoudre des problèmes "
"informatiques.</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence2.html:50
msgid ""
"\n"
"            <h4>B. Sélectionner les algorithmes adéquats pour répondre à un "
"problème donné</h4>\n"
"            "
msgstr ""

#: .\myapp\template\myapp\competence2.html:55
msgid ""
"\n"
"                <h5>AC1 – Choisir des structures de données complexes "
"adaptées au problème</h5>\n"
"                <p>Sélectionner et utiliser des structures comme les arbres, "
"graphes, ou tables de hachage selon le contexte et les besoins du projet.</"
"p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence2.html:62
msgid ""
"\n"
"                <h5>AC2 – Utiliser des techniques algorithmiques adaptées "
"pour des problèmes complexes</h5>\n"
"                <p>Appliquer des méthodes avancées (recherche "
"opérationnelle, optimisation globale, intelligence artificielle, etc.) pour "
"concevoir des solutions efficaces.</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence2.html:69
msgid ""
"\n"
"                <h5>AC3 – Comprendre les enjeux et moyens de sécurisation "
"des données et du code</h5>\n"
"                <p>Identifier les vulnérabilités potentielles et mettre en "
"œuvre des techniques de sécurisation adaptées (chiffrement, "
"authentification, contrôle d’accès…).</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence2.html:76
msgid ""
"\n"
"                <h5>AC4 – Évaluer l’impact environnemental et sociétal des "
"solutions proposées</h5>\n"
"                <p>Analyser la consommation de ressources et les effets des "
"choix technologiques sur l’environnement et la société, pour adopter des "
"pratiques responsables.</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence3.html:10
msgid ""
"\n"
"    <h2>Compétence 3 — Administrer des systèmes informatiques communicants "
"complexes</h2>\n"
"    <p>Installer, configurer, mettre à disposition, maintenir en conditions "
"opérationnelles des infrastructures, \n"
"        des services et des réseaux, et optimiser le système informatique "
"d'une organisation.\n"
"        Tout cela en sécurisant le système d'information, en appliquant les "
"normes et bonnes pratiques \n"
"        architecturales et de sécurité, et en garantissant la continuité "
"d'activité et la qualité de service.</p>\n"
"    "
msgstr ""

#: .\myapp\template\myapp\competence3.html:22
msgid ""
"\n"
"            <h4>A. Installer et configurer un poste de travail</h4>\n"
"            "
msgstr ""

#: .\myapp\template\myapp\competence3.html:27
msgid ""
"\n"
"                <h5>AC1 – Identifier les différents composants (matériels et "
"logiciels) d’un système numérique</h5>\n"
"                <p>Reconnaître les éléments matériels (processeur, mémoire, "
"disque, carte réseau…) et logiciels \n"
"                    (système d’exploitation, pilotes, applications) d’un "
"poste informatique et comprendre leurs interactions.</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence3.html:35
msgid ""
"\n"
"                <h5>AC2 – Utiliser les fonctionnalités de base d’un système "
"multitâches / multiutilisateurs</h5>\n"
"                <p>Utiliser les principales commandes et fonctionnalités des "
"systèmes d’exploitation modernes \n"
"                    (gestion des utilisateurs, processus, fichiers, et "
"permissions).</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence3.html:43
msgid ""
"\n"
"                <h5>AC3 – Installer et configurer un système d’exploitation "
"et des outils de développement</h5>\n"
"                <p>Mettre en place un environnement de travail complet : "
"installation d’un OS (Linux, Windows), \n"
"                    des IDE, compilateurs, et utilitaires nécessaires au "
"développement.</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence3.html:51
msgid ""
"\n"
"                <h5>AC4 – Configurer un poste de travail dans un réseau "
"d’entreprise</h5>\n"
"                <p>Paramétrer l’accès réseau (adresse IP, DNS, passerelle), "
"rejoindre un domaine, \n"
"                    et assurer la communication sécurisée avec les autres "
"machines du réseau.</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence3.html:61
msgid ""
"\n"
"            <h4>B. Déployer des services dans une architecture réseau</h4>\n"
"            "
msgstr ""

#: .\myapp\template\myapp\competence3.html:66
msgid ""
"\n"
"                <h5>AC1 – Concevoir et développer des applications "
"communicantes</h5>\n"
"                <p>Créer des applications capables d’échanger des données à "
"travers un réseau \n"
"                    (client/serveur, API REST, communication entre objets "
"connectés, etc.).</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence3.html:74
msgid ""
"\n"
"                <h5>AC2 – Utiliser des serveurs et des services réseaux "
"virtualisés</h5>\n"
"                <p>Mettre en place et gérer des serveurs (web, base de "
"données, DNS, etc.) \n"
"                    et utiliser la virtualisation (VM, conteneurs, cloud) "
"pour les déployer efficacement.</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence3.html:82
msgid ""
"\n"
"                <h5>AC3 – Sécuriser les services et données d’un système</"
"h5>\n"
"                <p>Appliquer les principes de cybersécurité : chiffrement, "
"pare-feu, sauvegardes, \n"
"                    authentification et autorisation, afin de protéger les "
"données et les services d’une organisation.</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence4.html:10
msgid ""
"\n"
"    <h2>Compétence 4 — Gérer des données de l’information</h2>\n"
"    <p>Concevoir, gérer, administrer et exploiter les données de "
"l’entreprise afin de mettre à disposition \n"
"        toutes les informations nécessaires au bon pilotage de "
"l’organisation. \n"
"        Cette compétence implique le respect des réglementations sur la vie "
"privée et la protection des données, \n"
"        la prise en compte des enjeux économiques, sociétaux et écologiques "
"liés au stockage, \n"
"        ainsi que la garantie de la cohérence et de la qualité des "
"informations manipulées.</p>\n"
"    "
msgstr ""

#: .\myapp\template\myapp\competence4.html:23
msgid ""
"\n"
"            <h4>A. Concevoir et mettre en place une base de données à partir "
"d’un cahier des charges client</h4>\n"
"            "
msgstr ""

#: .\myapp\template\myapp\competence4.html:28
msgid ""
"\n"
"                <h5>AC1 – Mettre à jour et interroger une base de données "
"relationnelle</h5>\n"
"                <p>Utiliser le langage SQL pour interroger et modifier des "
"données (SELECT, INSERT, UPDATE, DELETE), \n"
"                    soit directement, soit à travers une application "
"connectée à la base de données.</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence4.html:36
msgid ""
"\n"
"                <h5>AC2 – Visualiser des données</h5>\n"
"                <p>Présenter les informations de manière lisible et "
"exploitable grâce à des outils de visualisation \n"
"                    (tableaux de bord, graphiques, rapports dynamiques, "
"etc.).</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence4.html:44
msgid ""
"\n"
"                <h5>AC3 – Concevoir une base de données relationnelle à "
"partir d’un cahier des charges</h5>\n"
"                <p>Analyser les besoins du client, créer un modèle "
"conceptuel de données (MERISE, UML), \n"
"                    le traduire en schéma relationnel et implémenter la "
"structure dans un SGBD.</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence4.html:54
msgid ""
"\n"
"            <h4>B. Optimiser une base de données, interagir avec une "
"application et mettre en œuvre la sécurité</h4>\n"
"            "
msgstr ""

#: .\myapp\template\myapp\competence4.html:59
msgid ""
"\n"
"                <h5>AC1 – Optimiser les modèles de données de l’entreprise</"
"h5>\n"
"                <p>Analyser la performance des requêtes, créer des index, \n"
"                    revoir la conception du schéma et ajuster les structures "
"de données pour améliorer la rapidité et la fiabilité du système.</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence4.html:67
msgid ""
"\n"
"                <h5>AC2 – Assurer la confidentialité des données (intégrité "
"et sécurité)</h5>\n"
"                <p>Mettre en place des mécanismes de sécurité : droits "
"d’accès, chiffrement, audit, sauvegardes, \n"
"                    et conformité aux réglementations (RGPD, CNIL).</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence4.html:75
msgid ""
"\n"
"                <h5>AC3 – Organiser la restitution de données à travers la "
"programmation et la visualisation</h5>\n"
"                <p>Développer des applications ou interfaces qui extraient, "
"transforment et présentent les données de manière claire \n"
"                    et utile pour la prise de décision (dashboards, rapports "
"dynamiques, APIs de consultation, etc.).</p>\n"
"                "
msgstr ""

#: .\myapp\template\myapp\competence4.html:83
msgid ""
"\n"
"                <h5>AC4 – Manipuler des données hétérogènes</h5>\n"
"                <p>Intégrer et gérer différents types de données "
"(relationnelles, NoSQL, JSON, XML, flux temps réel, etc.) \n"
"                    pour les rendre cohérentes et exploitables dans un même "
"système d’information.</p>\n"
"                "
msgstr ""

